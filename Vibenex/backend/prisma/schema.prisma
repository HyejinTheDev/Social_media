// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum SpaceRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum ChannelType {
  TEXT
  ANNOUNCEMENT
  SHOWCASE
}

enum NotificationType {
  LIKE             // Kept for backward compatibility or simple reactions
  COMMENT          // Kept for backward compatibility
  FOLLOW           // Kept for backward compatibility
  MENTION
  MESSAGE
  SPACE_INVITE
  THREAD_REPLY
  REACTION
}

// ==================== MODELS ====================

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  password         String
  name             String
  username         String         @unique
  bio              String?
  avatar           String?
  coverPhoto       String?
  reputation       Int            @default(0)
  isVerified       Boolean        @default(false)
  
  // Relations
  spaceMemberships SpaceMember[]
  discussions      Discussion[]
  replies          Reply[]
  reactions        Reaction[]
  
  // Chat Relations
  sentMessages     Message[]      @relation("sender")
  conversations1   Conversation[] @relation("participant1")
  conversations2   Conversation[] @relation("participant2")
  
  notifications    Notification[]
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Space {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  icon        String?        // URL to space icon
  banner      String?        // URL to banner image
  isPublic    Boolean        @default(true)
  memberCount Int            @default(0)
  
  channels    Channel[]
  members     SpaceMember[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model SpaceMember {
  id        String    @id @default(uuid())
  spaceId   String
  space     Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  role      SpaceRole @default(MEMBER)
  
  joinedAt  DateTime  @default(now())

  @@unique([spaceId, userId])
}

model Channel {
  id          String       @id @default(uuid())
  spaceId     String
  space       Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String       // e.g. "general", "showcase"
  type        ChannelType  @default(TEXT)
  description String?
  position    Int          @default(0)
  
  discussions Discussion[]
  
  createdAt   DateTime     @default(now())
}

model Discussion {
  id           String     @id @default(uuid())
  channelId    String
  channel      Channel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id])
  content      String
  imageUrls    String[]
  linkUrl      String?
  isPinned     Boolean    @default(false)
  replyCount   Int        @default(0)
  reactionCount Int       @default(0)
  
  replies      Reply[]
  reactions    Reaction[]
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Reply {
  id           String     @id @default(uuid())
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  parentId     String?    // For nested replies
  parent       Reply?     @relation("ReplyThread", fields: [parentId], references: [id])
  children     Reply[]    @relation("ReplyThread")
  authorId     String
  author       User       @relation(fields: [authorId], references: [id])
  content      String
  
  reactions    Reaction[]
  
  createdAt    DateTime   @default(now())
}

model Reaction {
  id           String      @id @default(uuid())
  emoji        String      // "🚀", "❤️", "👏", etc.
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  
  discussionId String?
  discussion   Discussion? @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  
  replyId      String?
  reply        Reply?      @relation(fields: [replyId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime    @default(now())

  @@unique([userId, discussionId, emoji])
  @@unique([userId, replyId, emoji])
}

model Conversation {
  id             String    @id @default(uuid())
  participant1Id String
  participant2Id String
  participant1   User      @relation("participant1", fields: [participant1Id], references: [id])
  participant2   User      @relation("participant2", fields: [participant2Id], references: [id])
  lastMessage    String?
  lastMessageAt  DateTime?
  messages       Message[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([participant1Id, participant2Id])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("sender", fields: [senderId], references: [id])
  content        String
  imageUrl       String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}
